# Copy to .env.local and fill locally; never commit .env.local.
# Server-side Qloo key: do not use NEXT_PUBLIC_ prefix.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Server-side Gemini API key. Do not use NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
# Verify the available/approved Gemini model name with the current Google Gen AI documentation/account.
GEMINI_MODEL=

# Firebase web app configuration. Firebase web config is public app configuration; Firestore rules are the security boundary.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Optional if a concrete server-owned Firebase Admin operation is chosen. Do not store a service-account JSON in git.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Optional operational settings; implement only where used.
# APP_BASE_URL=http://localhost:3000
# MAX_AGENT_STEPS=4
# GENERATION_COOLDOWN_SECONDS=15
